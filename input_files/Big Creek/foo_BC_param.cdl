		tcan:units = "C" ;
		tcan:long_name = "Vegetation canopy temperature" ;
	float tsno(gru) ;
		tsno:_FillValue = -999.f ;
		tsno:units = "C" ;
		tsno:long_name = "Snowpack temperature" ;
