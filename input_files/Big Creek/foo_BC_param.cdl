netcdf MESH_parameters {
dimensions:
	gru = 11 ;
	NGRU = 12 ;
	lat = 30 ;
	lon = 20 ;
	icp1 = 5 ;
	layer = 5 ;
	ic = 4 ;
	icctem = 9 ;
	iccp2 = 11 ;
	slope = 8 ;
variables:
	float lat(lat) ;
		lat:_FillValue = NaNf ;
		lat:standard_name = "latitude" ;
		lat:units = "degrees_north" ;
		lat:axis = "Y" ;
	float lon(lon) ;
		lon:_FillValue = NaNf ;
		lon:standard_name = "longitude" ;
		lon:units = "degrees_east" ;
		lon:axis = "X" ;
	int crs ;
		crs:grid_mapping_name = "latitude_longitude" ;
		crs:longitude_of_prime_meridian = 0.f ;
		crs:semi_major_axis = 6378137.f ;
		crs:inverse_flattening = 298.2572f ;
	int layer(layer) ;
		layer:standard_name = "ground layers" ;
	float delz(layer) ;
		delz:_FillValue = NaNf ;
		delz:units = "m" ;
		delz:long_name = "Ground layer thickness" ;
	int rank(lat, lon) ;
		rank:coordinates = "longitude latitude" ;
		rank:grid_mapping = "crs" ;
	int next(lat, lon) ;
	float da(lat, lon) ;
	float chnlslope(lat, lon) ;
	float chnllength(lat, lon) ;
	float gridarea(lat, lon) ;
	float gru(NGRU, lat, lon) ;
		gru:coordinates = "longitude latitude" ;
		gru:grid_mapping = "crs" ;
	int ic(ic) ;
		ic:standard_name = "physics (CLASS) PFTs" ;
	int iccp2(iccp2) ;
		iccp2:standard_name = "biogeochemical (CTEM) PFTs plus bareground and land use change product pools" ;
	int icctem(icctem) ;
		icctem:standard_name = "biogeochemical (CTEM) PFTs" ;
	int icp1(icp1) ;
		icp1:standard_name = "physics (CLASS) PFTs plus bareground" ;
	float fcan(gru, icp1) ;
		fcan:_FillValue = -999.f ;
		fcan:units = "-" ;
		fcan:long_name = "Annual maximum fractional coverage of modelled area (read in for CLASS only runs)" ;
	float lnz0(gru, icp1) ;
		lnz0:_FillValue = -999.f ;
		lnz0:units = "-" ;
		lnz0:long_name = "Natural logarithm of maximum vegetation roughness length" ;
	float alvc(gru, icp1) ;
		alvc:_FillValue = -999.f ;
		alvc:units = "-" ;
		alvc:long_name = "Average visible albedo of vegetation category when fully-leafed" ;
	float alic(gru, icp1) ;
		alic:_FillValue = -999.f ;
		alic:units = "-" ;
		alic:long_name = "Average near-IR albedo of vegetation category when fully-leafed" ;
	float pamx(gru, ic) ;
		pamx:_FillValue = -999.f ;
		pamx:units = "m2/m2" ;
		pamx:long_name = "Annual maximum plant area index of vegetation category" ;
	float pamn(gru, ic) ;
		pamn:_FillValue = -999.f ;
		pamn:units = "m2/m2" ;
		pamn:long_name = "Annual minimum plant area index of vegetation category" ;
	float cmas(gru, ic) ;
		cmas:_FillValue = -999.f ;
		cmas:units = "$[kg m^{-2} ]$" ;
		cmas:long_name = "Annual maximum canopy mass for vegetation category" ;
	float root(gru, ic) ;
		root:_FillValue = -999.f ;
		root:units = "m" ;
		root:long_name = "Annual maximum rooting depth of vegetation category" ;
	float rsmn(gru, ic) ;
	float qa50(gru, ic) ;
	float vpda(gru, ic) ;
	float vpdb(gru, ic) ;
	float psga(gru, ic) ;
	float psgb(gru, ic) ;
	float drn(gru) ;
		drn:_FillValue = -999.f ;
		drn:units = "-" ;
		drn:long_name = "Soil drainage index" ;
	float sdep(gru) ;
		sdep:_FillValue = -999.f ;
		sdep:units = "m" ;
		sdep:long_name = "Soil permeable depth" ;
	float fare(gru) ;
		fare:_FillValue = -999.f ;
		fare:units = "fraction" ;
		fare:long_name = "Tile fractional area of gridcell" ;
	float dd(gru) ;
